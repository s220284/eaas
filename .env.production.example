# MASH AI Production Configuration
# Copy this to .env.production and fill in real values

# Database - Cloud SQL PostgreSQL
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://mash_user:CHANGE_ME@/mash_ai?host=/cloudsql/PROJECT_ID:us-central1:mash-ai-db

# Authentication - Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_A_SECURE_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Application Settings
DEBUG=false
ENVIRONMENT=production

# Frontend URL (for CORS) - Update after Vercel deployment
FRONTEND_URL=https://mash-ai.vercel.app

# GCP Settings (set automatically by Cloud Run)
# PORT=8080
# GOOGLE_CLOUD_PROJECT=your-project-id
